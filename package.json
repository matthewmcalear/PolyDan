{
  "name": "polydan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "node prisma/seed.mjs",
    "test:db": "DATABASE_URL=postgresql://$USER@localhost:5432/polydan_test vitest run -c vitest.db.config.mts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "typescript": "^5.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "postcss": "^8.4.35",
    "vitest": "4.1.8"
  }
}
